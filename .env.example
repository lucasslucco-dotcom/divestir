# Copie este arquivo para .env.local e preencha com os dados do projeto Divestir no Supabase.
# Os mesmos dois valores vão nas variáveis de ambiente do projeto na Vercel.
# Os dois são públicos por natureza (vão para o navegador). A chave secreta NUNCA entra aqui.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só no servidor: na Vercel, em Settings → Environment Variables. Nunca com NEXT_PUBLIC_ na frente.
# Chave da API do Photoroom, que tira o fundo das fotos dos clientes.
PHOTOROOM_API_KEY=
# Vazio = modo de teste gratuito do Photoroom (com marca d'água). "producao" = modo pago, sem marca.
PHOTOROOM_MODO=
