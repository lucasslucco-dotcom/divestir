# Copie este arquivo para .env.local e preencha com os dados do projeto Divestir.
# Os mesmos valores vão nas variáveis de ambiente do projeto na Vercel.
# Este arquivo só lista os nomes: valor de chave nenhum entra no GitHub.

# Públicos por natureza (vão para o navegador).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só no servidor: na Vercel, em Settings → Environment Variables. Nunca com NEXT_PUBLIC_ na frente.
# Chave secreta do Supabase (sb_secret_...). Ela passa por cima das regras de acesso do banco:
# o site usa só para abrir a vaga da foto do cliente e guardar o recorte no espaço privado.
SUPABASE_SECRET_KEY=
# Chave da API do Photoroom, que tira o fundo das fotos dos clientes.
PHOTOROOM_API_KEY=
# Vazio = modo de teste gratuito do Photoroom (com marca d'água). "producao" = modo pago, sem marca.
PHOTOROOM_MODO=

# Pagamento pelo Mercado Pago (Etapa 6). A chave pública vai para o navegador; não é segredo.
MERCADOPAGO_PUBLIC_KEY=
# Só no servidor: a chave secreta (Access Token) e a assinatura secreta dos avisos (webhooks).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_ASSINATURA=
# Vazio = modo de teste (preços de teste, pagamentos de mentira). "producao" = vendas de verdade.
PAGAMENTO_MODO=

# Frete pelo Melhor Envio. Sem o token ou sem o CEP de origem, o frete é simulado.
# Só no servidor: o token da conta do Melhor Envio, gerado no painel (Integrações → Permissões de
# acesso → Tokens) só com a permissão de cotação de frete. Vale cerca de um ano.
MELHORENVIO_TOKEN=
# Vazio = conta de teste (sandbox). "producao" = conta de verdade.
MELHORENVIO_AMBIENTE=
# CEP de onde as peças saem e o e-mail de contato técnico que o Melhor Envio pede.
FRETE_CEP_ORIGEM=
MELHORENVIO_CONTATO=
